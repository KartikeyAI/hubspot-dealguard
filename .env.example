# HubSpot and application
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_APP_ID=
APP_BASE_URL=http://localhost:8787
TOKEN_ENCRYPTION_KEY=
ADMIN_API_KEY=
EMAIL_FROM=DealGuard <dealguard@rokad.co>
SUPPORT_EMAIL=company@rokad.co
RESEND_API_KEY=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Neon PostgreSQL. The Worker connects directly with NEON_DATABASE_URL.
DATABASE_URL=postgresql://dealguard:password@localhost:5432/dealguard
NEON_DATABASE_URL=
NEON_RESTORE_DATABASE_URL=

# Tigris S3-compatible object storage
TIGRIS_ENDPOINT=https://t3.storage.dev
TIGRIS_REGION=auto
TIGRIS_BUCKET=
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=

# Cloudflare Queues
SCAN_QUEUE_NAME=dealguard-scans-staging
DELIVERY_QUEUE_NAME=dealguard-delivery-staging
MAINTENANCE_QUEUE_NAME=dealguard-maintenance-staging
DEAD_LETTER_QUEUE_NAME=dealguard-dead-letter-staging

# Dodo Payments
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=test
DODO_GROWTH_MONTHLY_PRODUCT_ID=
DODO_GROWTH_YEARLY_PRODUCT_ID=
DODO_ENTERPRISE_MONTHLY_PRODUCT_ID=
DODO_ENTERPRISE_YEARLY_PRODUCT_ID=
DODO_AI_CREDIT_EVENT_NAME=dealguard_ai_credit
DODO_ACTIVE_DEAL_EVENT_NAME=dealguard_active_deal
DODO_EVENT_OVERAGE_EVENT_NAME=dealguard_event
DODO_RETENTION_EVENT_NAME=dealguard_retention_gb_month

# Live acceptance runner (do not commit populated values)
ACCEPTANCE_PROFILE=read-only
ACCEPTANCE_BASE_URL=https://dealguard-api-staging.rokad.co
ACCEPTANCE_PORTAL_ID=
ACCEPTANCE_USER_ID=
ACCEPTANCE_USER_EMAIL=
ACCEPTANCE_EXPECT_TIER=
ACCEPTANCE_TEST_DEAL_ID=
ACCEPTANCE_CHECKOUT_TIER=enterprise
ACCEPTANCE_CHECKOUT_INTERVAL=year
ACCEPTANCE_TIMEOUT_MS=25000
ACCEPTANCE_OUTPUT_DIR=artifacts/acceptance
