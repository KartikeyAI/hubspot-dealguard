{
  "name": "@rokadhq/hubspot-dealguard",
  "version": "1.0.0-beta.1",
  "private": true,
  "type": "module",
  "description": "DealGuard by Rokad — HubSpot deal readiness and sales handoff governance.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm run typecheck:ui && npm test",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply dealguard-production --local",
    "db:migrate:remote": "wrangler d1 migrations apply dealguard-production --remote",
    "hubspot:deps": "hs project install-deps",
    "hubspot:dev": "hs project dev",
    "hubspot:upload": "hs project upload",
    "typecheck:ui": "npm run typecheck --prefix src/app/cards && npm run typecheck --prefix src/app/settings"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260713.1",
    "typescript": "5.9.3",
    "wrangler": "4.110.0"
  }
}
