{
  "uid": "rokad_dealguard_app",
  "type": "app",
  "config": {
    "name": "DealGuard by Rokad",
    "description": "Enterprise HubSpot revenue governance with explainable scoring, approved policies, remediation SLAs, native reporting, routed notifications, subscription controls, and reliable delivery operations.",
    "logo": "/app/app-logo.png",
    "distribution": "marketplace",
    "auth": {
      "type": "oauth",
      "redirectUrls": [
        "https://dealguard-api.rokad.co/oauth/callback",
        "http://localhost:8787/oauth/callback"
      ],
      "requiredScopes": [
        "crm.objects.deals.read",
        "crm.objects.deals.write",
        "crm.objects.contacts.read",
        "crm.objects.companies.read",
        "crm.schemas.deals.read",
        "crm.schemas.deals.write"
      ],
      "optionalScopes": [
        "crm.objects.line_items.read",
        "crm.objects.quotes.read"
      ],
      "conditionallyRequiredScopes": []
    },
    "permittedUrls": {
      "fetch": [
        "https://dealguard-api.rokad.co/"
      ],
      "iframe": [],
      "img": []
    },
    "support": {
      "supportEmail": "company@rokad.co",
      "documentationUrl": "https://rokad.co/docs/dealguard",
      "supportUrl": "https://rokad.co/support?product=hubspot-dealguard"
    }
  }
}
